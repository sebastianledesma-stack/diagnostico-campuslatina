# ─── Frontend (Vite las incrusta en el bundle al compilar: solo valores públicos) ───
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# La anon key es pública por diseño: RLS solo le permite INSERT en diagnosticos.
VITE_SUPABASE_ANON_KEY=eyJ...
# Destino del botón "Escribinos" al pie del informe (mailto con mensaje precargado)
VITE_CONTACT_EMAIL=seba@campuslatina.com
# Opcional: si se define, el botón pasa a abrir WhatsApp (solo dígitos con código de país, ej 5491122334455)
VITE_CONTACT_WHATSAPP=

# ─── Servidor (solo Netlify Functions: nunca llegan al navegador) ───
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
RESEND_API_KEY=re_...
MAIL_FROM="Diagnóstico Campus Latina <no-reply@campuslatina.com>"
# Quién recibe el aviso interno de cada diagnóstico (separados por coma)
MAIL_INTERNAL_TO=seba@campuslatina.com
# Reply-To del informe y botón "Hablemos" del mail
CONTACT_EMAIL=seba@campuslatina.com
# URL pública del sitio (para el link al panel en el aviso interno)
SITE_URL=https://diagnostico.campuslatina.com
# Clave compartida para entrar a /admin (larga y difícil de adivinar; cambiarla cierra las sesiones abiertas)
ADMIN_CLAVE=
